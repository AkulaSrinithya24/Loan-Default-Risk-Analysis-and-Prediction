\"ruleID\":\"default\"},{\"gate\":\"3737660407\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"3922602262\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"1326334369\",\"gateValue\":\"true\",\"ruleID\":\"1whsR1iZoYMplZvM8wDcvp:100.00:7\"},{\"gate\":\"957497898\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"1833787017\",\"gateValue\":\"false\",\"ruleID\":\"default\"}],\"version\":621,\"id_type\":\"userID\",\"value\":{\"fiber_sync_hazelnut_skills_to_workspace\":false,\"max_messages_per_conversation\":1000,\"fiber_sync_suggestable_connectors_to_workspace\":false,\"automations_list_limit\":25,\"fiber_use_generic_chatgpt_builtin_tools\":true,\"exact_schedule_proactive_start_offset_seconds\":10,\"condition_watch_jitter_radius_seconds\":360,\"tool_model_instructions\":\"\",\"max_iterations_per_hour\":1,\"break_plugin_service_brte_history_chain\":true,\"max_turns_per_conversation\":175,\"private_peek_enabled\":true,\"exact_schedule_jitter_radius_seconds\":240,\"skip_completion_text\":\"::SKIP_COMPLETION::\",\"enable_whisper\":false,\"slack_webhook_bot_membership_message_template\":\"I couldn't create an immediate Slack monitor because @ChatGPT isn't in {channel}. I can still set up an hourly monitor right now, or you can install or reconnect the [ChatGPT Slack app](https://chatgpt.com/slack-ai-app-install), add @ChatGPT to the channel, and try again for immediate notifications. Which would you like?\",\"validate_automation_prompt_template\":\"\",\"fiber_generic_chatgpt_builtin_tool_references\":[{\"tool_type\":\"ToolRef\",\"tool_id\":\"automations\"},{\"tool_id\":\"image_gen\",\"tool_type\":\"ToolRef\"}],\"automations_create_plan_tool_additional_guidance\":\"The user has created an automation for an ongoing goal with a private plan. Collaborate with the user across turns, use available structured context to understand their goals and prior progress, and help advance the saved plan.\",\"additional_developer_message_prompt\":\"If you do not have an update for the user during this automation turn, you must emit `::SKIP_COMPLETION::`. UNLESS you have clarifying questions for the user that will help you perform your task - in which case, feel free to ask that question. \\n\\nExamples for when to output `::SKIP_COMPLETION::`:\\n- If the user asks you to let them know when a reservation opens up at Cotogna at a specific time, and you find out that there is still no reservation available\\n- If the user asks you to let them know when they have a new email but there are no new emails since your last run\",\"json_completion_prompt\":\"Complete the automation's work on every run, whether or not there is an update to send.\\nUse the user's instructions to decide whether this run warrants notifying them, including\\nrequested reminders and meaningful findings or changes.\\n\\nWhen the user should be notified, write your normal final response.\\nWhen no notification is needed but the response should appear in the user's conversation history,\\nmake your entire final response this JSON object with exactly these fields:\\n{\\\"type\\\": \\\"skip_notification\\\", \\\"reason\\\": \\\"Your full response to the task\\\"}.\\nWhen there is no useful update to add to the user's conversation history, omit reason and make your\\nentire final response {\\\"type\\\": \\\"skip_notification\\\"}. Do not wrap the JSON in a code fence or add\\ntext outside it.\\n\\nWrite reason as a fully natural assistant response addressed to the user. Include the useful\\nfindings, details of the work you did, and relevant limitations or next steps, with the same\\ndetail you would normally provide for the task. This response remains available in the run's\\nhistory. It does not need to justify skipping a notification or discuss notification mechanics.\\nUse normal prose and Markdown within the JSON string, escaping it as valid JSON.\",\"active_task_limit_message_template\":\"You've reached your limit of {active_limit} active tasks. To schedule more tasks, consider pausing some tasks.\",\"model_lane_override\":\"auto\",\"webhook_trigger_user_prompt_template\":\"{automation_prompt}\\n\\nThis run was triggered by a webhook event. Use the event below as the new information to evaluate for this run.\\nWebhook family: {family}\\nWebhook event:\\n{normalized_event_json}\",\"enable_file_export\":true,\"gaas_extra_features\":{\"multi_agent\":true,\"fast_mode\":true},\"automations_create_tool_additional_guidance\":\"Do NOT mention the automation id to the user in  your response.\",\"bypass_chat_model_output\":true,\"enable_browser_tool\":true,\"override_default_tools\":false,\"automations_list_tool_additional_guidance\":\"The UI will already render the user's active automations from this list result. The automations will be rendered below your response Do NOT restate active automations in prose unless adding information not already visible to the user. Do not tell the user about any automations with enabled = false. They are considered deleted. You do not need to mention the UI either. Simply summarize in 1 sentence or less what automations exist.\\n\\nDo not call the automations `list` action again this turn; use the automations `peek` action for any further inspection.\",\"personalized_task_card_read_timeout_seconds\":0.225,\"max_active_automations\":3,\"legacy_completion_prompt\":\"If you do not have an update for the user during this automation turn, you must emit `::SKIP_COMPLETION::`. UNLESS you have clarifying questions for the user that will help you perform your task - in which case, feel free to ask that question. \\n\\nExamples for when to output `::SKIP_COMPLETION::`:\\n- If the user asks you to let them know when a reservation opens up at Cotogna at a specific time, and you find out that there is still no reservation available\\n- If the user asks you to let them know when they have a new email but there are no new emails since your last run\\n\\nThe `::SKIP_COMPLETION::` logic should only apply to this turn. This guidance is no longer applicable after the next user turn.\",\"general_agent_invoked_system_hints\":[],\"fiber_tool_call_elicitation_mode\":\"elicit_on_writes\"},\"is_device_based\":false,\"passed\":true},\"1249441124\":{\"name\":\"1249441124\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":11,\"id_type\":\"userID\",\"value\":{},\"is_device_based\":false,\"passed\":false},\"842715733\":{\"name\":\"842715733\",\"rule_id\":\"launchedGroup\",\"secondary_exposures\":[],\"version\":17,\"id_type\":\"userID\",\"value\":{\"enabled\":true},\"is_device_based\":false,\"group_name\":\"inside_bubble\",\"is_experiment_active\":true,\"is_user_in_experiment\":false},\"2708744325\":{\"name\":\"2708744325\",\"rule_id\":\"3KK60G8XKPs9RVOJeJyxpR:100.00:1-3KK60EtVixiFywgNDBCU6P\",\"secondary_exposures\":[],\"version\":5,\"id_type\":\"workspace_id\",\"value\":{\"allowlisted_template_ids\":[\"templated_apps_69ebf5c883c881919ef2719759f226f6\"]},\"is_device_based\":false,\"passed\":true},\"3689744552\":{\"name\":\"3689744552\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":110,\"id_type\":\"userID\",\"value\":{\"scans_count\":5,\"remaining_scans_cta_threshold\":5,\"max_commits\":10000,\"lookback_days\":60,\"lookback_days_options\":[60],\"min_commits\":1000},\"is_device_based\":false,\"passed\":false},\"874923992\":{\"name\":\"874923992\",\"rule_id\":\"layerAssignment\",\"secondary_exposures\":[],\"version\":14,\"id_type\":\"userID\",\"value\":{},\"is_device_based\":false,\"is_experiment_active\":true,\"is_user_in_experiment\":false},\"2391622925\":{\"name\":\"2391622925\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":11,\"id_type\":\"userID\",\"value\":{\"use_backend_generated_jwt\":true,\"configuration_url\":\"https://chatgpt.com/admin\",\"self_serve_business_access_token_creation_enabled\":true},\"is_device_based\":false,\"passed\":false},\"574611634\":{\"name\":\"574611634\",\"rule_id\":\"default\",\"secondary_exposur