_detection_for_session\":false,\"detection_source\":\"image_element_probe_v1\"},\"is_device_based\":false,\"passed\":false},\"2850107578\":{\"name\":\"2850107578\",\"rule_id\":\"7nxmtzMrThjQ6ucoe2XHVB:100.00:21-7nxmty7pqZalN4EsCV24Cz\",\"secondary_exposures\":[{\"gate\":\"3796009202\",\"gateValue\":\"true\",\"ruleID\":\"70knO3S2IIQ3C4K3vmxsog:100.00:1\"}],\"version\":55,\"id_type\":\"userID\",\"value\":{\"android_display_zoom_scale_threshold\":1,\"ask_chatgpt_system_message\":\"The user is referring to an ad shown to them about: {LABEL}. Your response MUST BE ABOUT THE ADS shown, since the user explicitly asked about them. They are using the 'Ask ChatGPT' feature and you must reply to the user query using the information about the ads, which is:\\n{DATA}\\n\\nFor example: if the user asks 'Tell me more about these' (or other wordings), then your answer should be about details or further information on products, services, locations etc described in the ad and the links in the ad.\",\"onboarding\":{\"card_image_url\":\"https://cdn.openai.com/chatgpt/clients/onboarding/onboarding-example-1.png\",\"screen_personalization_image_url\":\"https://cdn.openai.com/chatgpt/clients/bazaar/onboarding/personalization_en.png\",\"screen_transparency_image_url_when_personalization_unavailable\":\"https://cdn.openai.com/chatgpt/clients/bazaar/onboarding/personalization_unavailable_transparency_v1.jpg\",\"screen_privacy_image_url\":\"https://cdn.openai.com/chatgpt/clients/bazaar/onboarding/secure.png\",\"screen_transparency_image_url\":\"https://cdn.openai.com/chatgpt/clients/bazaar/onboarding/controls_en.png\",\"impression_count\":5,\"screen_trust_image_url_when_personalization_unavailable\":\"https://cdn.openai.com/chatgpt/clients/bazaar/onboarding/personalization_unavailable_trust_v1.jpg\",\"screen_trust_image_url\":\"https://cdn.openai.com/chatgpt/clients/bazaar/onboarding/trusted_en.png\"},\"late_ads_event_discard_timeout_seconds\":5,\"late_ads_event_discard_timeout_after_message_end_visibility_seconds\":3.5,\"android_large_font_scale_threshold\":1.5},\"is_device_based\":false,\"passed\":true},\"1922670275\":{\"name\":\"1922670275\",\"rule_id\":\"launchedGroup\",\"secondary_exposures\":[],\"version\":5,\"id_type\":\"stableID\",\"value\":{\"download_mode\":\"micro_installer\"},\"is_device_based\":true,\"group_name\":\"Micro-installer\",\"is_experiment_active\":false,\"is_user_in_experiment\":false},\"2214612631\":{\"name\":\"2214612631\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":7,\"id_type\":\"userID\",\"value\":{\"trigger_words\":[\"messi\",\"soccer\",\"FIFA\",\"World Cup\"]},\"is_device_based\":false,\"passed\":false},\"1977158438\":{\"name\":\"1977158438\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":4,\"id_type\":\"userID\",\"value\":{\"user_prompt_key\":\"good_option\",\"enable_web_search\":false,\"system_prompt\":\"The user is asking about an ad shown to them by {advertiser}. Your response must be about the ad shown. They are using the \\\"Ask ChatGPT\\\" feature to get ChatGPT's honest opinion on the product(s) in the advertisement, and in which situations it could be a great fit for them. You should be honest about when you think the product(s) would vs. would not be useful for the user, based on what you know about them.\\n\\nInformation about the ad:\\n{ad}.\\n\\nStructure your response in the following manner:\\n- Briefly describe the type of user, use case, or situation where this ad/product makes sense for the user.\\n- If appropriate, explain any mismatches with the user's stated preferences or goals. That is, where might it fall short for the user (if appropriate)? You don't have to do this for every query, but feel free to list limitations if you think they're pretty relevant.\\n- Give a concise recommendation (e.g., \\\"worth considering,\\\" \\\"probably not ideal,\\\" \\\"good budget option,\\\" \\\"seriously may be a fit,\\\" etc.)\\n\\nGuidelines:\\n- Be honest and practical.\\n- Do not blindly promote the ad.\\n- Avoid harsh or absolute negative language.\\n- Do not invent details not present in the ad.\\n- Focus on fit, not feature lists.\\n- If the mark on relevance is clearly missed, feel free to be funny with it and keep it lighthearted. Do not mock the user or advertiser; keep the humor gentle.\\n\\nKeep it concise, direct, and easy to scan.\\n\\n{conversation}\"},\"is_device_based\":false,\"passed\":false},\"1821234005\":{\"name\":\"1821234005\",\"rule_id\":\"3sBs88SylWKvNuRCkwZi6W\",\"secondary_exposures\":[{\"gate\":\"3743432195\",\"gateValue\":\"true\",\"ruleID\":\"14L7KJMWMGpXyyNZOAVNaE\"}],\"version\":28,\"id_type\":\"stableID\",\"value\":{\"encoding\":\"identity\"},\"is_device_based\":true,\"group_name\":\"Control\",\"is_experiment_active\":true,\"is_user_in_experiment\":true},\"690794452\":{\"name\":\"690794452\",\"rule_id\":\"launchedGroup\",\"secondary_exposures\":[{\"gate\":\"1698194209\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"700086370\",\"gateValue\":\"false\",\"ruleID\":\"7wGKMG5gthfn3twYmASyeB\"},{\"gate\":\"3643162575\",\"gateValue\":\"true\",\"ruleID\":\"56j9Tu0CGzcoiVbnTxuR7O\"},{\"gate\":\"4136617744\",\"gateValue\":\"false\",\"ruleID\":\"26iujld4K5MCAd77dzxsGW\"},{\"gate\":\"2958953032\",\"gateValue\":\"true\",\"ruleID\":\"5307jVlQCqV55kmlqhlQqk\"}],\"version\":30,\"id_type\":\"userID\",\"value\":{\"enabled\":true,\"sunspot-default-on\":false,\"preserve_moderation_on_save\":true,\"default_personalized\":true},\"is_device_based\":false,\"is_in_layer\":true,\"explicit_parameters\":[\"enabled\",\"default_personalized\"],\"group_name\":\"Personalization default on\",\"is_experiment_active\":false,\"is_user_in_experiment\":false},\"3586803603\":{\"name\":\"3586803603\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":12,\"id_type\":\"userID\",\"value\":{\"default\":\"legacy\",\"app_modes\":{\"connector_openai_deep_research\":\"dns_safe_v1\",\"asdk_app_6a59aa7c1f50819184bcdac496bd4cb5\":\"