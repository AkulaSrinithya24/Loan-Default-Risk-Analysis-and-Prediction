.54183 11.2686ZM15.742 4.23637C14.9045 3.37296 13.4757 3.3368 12.5653 4.24516L12.1522 4.65727L15.3348 7.84086L15.7489 7.42778C16.6655 6.51112 16.6228 5.08792 15.7577 4.252L15.742 4.23637Z" fill="currentColor"></path></svg></div></span></button></div></div></div></div><span class="sr-only"><br></span></section></div><div class="" data-turn-id-container="af4917aa-dc34-4475-822b-aa52a21edb5f" data-is-intersecting="true"><section class="text-token-text-primary w-full focus:outline-none has-data-writing-block:pointer-events-none [&amp;:has([data-writing-block])&gt;*]:pointer-events-auto R6Vx5W_threadScrollVars scroll-mb-[calc(var(--scroll-root-safe-area-inset-bottom,0px)+var(--thread-response-height))] scroll-mt-[calc(var(--header-height)+min(200px,max(70px,20svh)))]" dir="auto" data-turn-id="af4917aa-dc34-4475-822b-aa52a21edb5f" data-turn-id-container="af4917aa-dc34-4475-822b-aa52a21edb5f" data-testid="conversation-turn-10" data-turn="assistant"><h4 class="sr-only select-none">ChatGPT said:</h4><div class="text-base my-auto mx-auto [--thread-content-margin:var(--thread-content-margin-xs,calc(var(--spacing)*4))] @w-sm/main:[--thread-content-margin:var(--thread-content-margin-sm,calc(var(--spacing)*6))] @w-lg/main:[--thread-content-margin:var(--thread-content-margin-lg,calc(var(--spacing)*16))] px-(--thread-content-margin)"><div data-conversation-screenshot-content="" class="[--thread-content-max-width:40rem] @w-lg/main:[--thread-content-max-width:48rem] mx-auto max-w-(--thread-content-max-width) flex-1 group/turn-messages focus-visible:outline-hidden relative flex w-full min-w-0 flex-col agent-turn"><div class="flex max-w-full flex-col gap-4 [&amp;&gt;div:has([data-free-thinking-preview-answer=true])+:is(.text-message,.relative:has(&gt;.text-message))]:-mt-2 grow"><div class="contents"><div class="contents"></div></div><div data-message-author-role="assistant" data-message-id="1dfbb1f4-af29-4af0-a692-dab4990cfae7" dir="auto" data-message-model-slug="gpt-5-6" class="min-h-8 text-message relative flex w-full flex-col items-end gap-2 text-start break-words whitespace-normal outline-none keyboard-focused:focus-ring [.text-message+&amp;]:mt-1"><div class="flex w-full flex-col gap-1 empty:hidden"><div class="LR5Y_W_content markdown prose dark:prose-invert wrap-break-word w-full light markdown-new-styling"><p dir="auto" data-start="0" data-end="339">Yes — <strong data-start="6" data-end="47">your project is now working correctly</strong>, and the model-performance values you obtained are consistent with the deployed <code data-start="128" data-end="153">deployment_model.joblib</code>. You do <strong data-start="162" data-end="169">not</strong> need to add a lot more. But before final submission, I would make a few important updates to the report so that it exactly matches your current GitHub/Streamlit project.</p>
<h3 data-section-id="inspxi" dir="auto" data-start="341" data-end="390">1. Update Section 8.4 with your actual values</h3>
<p dir="auto" data-start="392" data-end="445">From your terminal, the current deployed model gives:</p>
<div dir="auto" class="group TyagGW_tableContainer"><div tabindex="-1" class="TyagGW_tableWrapper flex flex-col-reverse w-fit"><table data-start="447" data-end="612" dir="auto" class="w-fit min-w-(--thread-content-width)"><thead data-start="447" data-end="473"><tr data-start="447" data-end="473"><th data-start="447" data-end="456" data-col-size="sm" class="last:pe-10">Metric</th><th data-start="456" data-end="473" data-col-size="sm" class="last:pe-10" style="text-align: right;">Random Forest</th></tr></thead><tbody data-start="485" data-end="612"><tr data-start="485" data-end="513"><td data-start="485" data-end="499" data-col-size="sm"><strong data-start="487" data-end="498">ROC-AUC</strong></td><td data-start="499" data-end="513" data-col-size="sm" style="text-align: right;"><strong data-start="501" data-end="511">0.7444</strong></td></tr><tr data-start="514" data-end="548"><td data-start="514" data-end="534" data-col-size="sm"><strong data-start="516" data-end="533">Avg Precision</strong></td><td data-start="534" data-end="548" data-col-size="sm" style="text-align: right;"><strong data-start="536" data-end="546">0.3059</strong></td></tr><tr data-start="549" data-end="582"><td data-start="549" data-end="568" data-col-size="sm"><strong data-start="551" data-end="567">F1 (Default)</strong></td><td data-start="568" data-end="582" data-col-size="sm" style="text-align: right;"><strong data-start="570" data-end="580">0.3242</strong></td></tr><tr data-start="583" data-end="612"><td data-start="583" data-end="598" data-col-size="sm"><strong data-start="585" data-end="597">Accuracy</strong></td><td data-start="598" data-end="612" data-col-size="sm" style="text-align: right;"><strong data-start="600" data-end="610">0.6537</strong></td></tr></tbody></table><div class="relative h-0 self-end select-none"><div class="absolute end-0 flex items-end" style="height: 32.7969px;"><span class="" data-state="closed"><button aria-label="Copy table" class="hover:bg-token-bg-tertiary text-token-text-secondary relative z-10 my-1 rounded-sm p-1 transition-opacity group-[:not(:hover):not(:focus-within)]:pointer-events-none group-[:not(:hover):not(:focus-within)]:opacity-0"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" aria-hidden="true" class="icon"><use href="/cdn/assets/sprites-core-07247886.svg#7fccfb" fill="currentColor"></use></svg></button></span></div></div></div></div>
<p dir="auto" data-start="614" data-end="618">And:</p>
<ul data-start="620" data-end="730">
<li data-section-id="ut117m" data-start="620" data-end="643">
<p dir="auto" data-start="622" data-end="643">Test rows: <strong data-start="633" data-end="643">51,070</strong></p>
</li>
<li data-section-id="19ovde7" data-start="644" data-end="674">
<p dir="auto" data-start="646" data-end="674">Decision threshold: <strong data-start="666" data-end="674">0.40</strong></p>
</li>
<li data-section-id="dkdirm" data-start="675" data-end="730">
<p dir="auto" data-start="677" data-end="730">Dataset after cleaning: <strong data-start="701" data-end="730">255,347 rows × 17 columns</strong></p>
</li>
</ul>
<p dir="auto" data-start="732" data-end="792">So replace the <code data-start="747" data-end="750">–</code> values in your report with these numbers.</p>
<p dir="auto" data-start="794" data-end="813">Your current table:</p>
<blockquote data-start="815" data-end="862">
<p dir="auto" data-start="817" data-end="862">Logistic Regression | Random Forest<br data-start="852" data-end="855">
– | –</p>
</blockquote>
<p dir="auto" data-start="864" data-end="896">should <strong data-start="871" data-end="895">not remain like that</strong>.</p>
<p dir="auto" data-start="898" data-end="1035">If you did not actually train/evaluate Logistic Regression in the final version, don't invent values for it. You can change the table to:</p>
<div dir="auto" class="group TyagGW_tableContainer"><div tabindex="-1" class="TyagGW_tableWrapper flex flex-col-reverse w-fit"><table data-start="1037" data-end="1179" dir="auto" class="w-fit min-w-(--thread-content-width)"><thead data-start="1037" data-end="1072"><tr data-start="1037" data-end="1072"><th data-start="1037" data-end="1046" data-col-size="sm" class="last:pe-10">Metric</th><th data-start="1046" data-end="1072" data-col-size="sm" class="last:pe-10" style="text-align: right;">Deployed Random Forest</th></tr></thead><tbody data-start="1084" data-end="1179"><tr data-start="1084" data-end="1104"><td data-start="1084" data-end="1094" data-col-size="sm">ROC-AUC</td><td data-start="1094" data-end="1104" data-col-size="sm" style="text-align: right;">0.7444</td></tr><tr data-start="1105" data-end="1131"><td data-start="1105" data-end="1121" data-col-size="sm">Avg Precision</td><td data-start="1121" data-end="1131" data-col-size="sm" style="text-align: right;">0.3059</td></tr><tr data-start="1132" data-end="1157"><td data-start="1132" data-end="1147" data-col-size="sm">F1 (Default)</td><td data-start="1147" data-end="1157" data-col-size="sm" style="text-align: right;">0.3242</td></tr><tr data-start="1158" data-end="1179"><td data-start="1158" data-end="1169" data-col-size="sm">Accuracy</td><td data-start="1169" data-end="1179" data-col-size="sm" style="text-align: right;">0.6537</td></tr></tbody></table><div class="relative h-0 self-end select-none"><div class="absolute end-0 flex items-end" style="height: 32.7969px;"><span class="" data-state="closed"><button aria-label="Copy table" class="hover:bg-token-bg-tertiary text-token-text-secondary relative z-10 my-1 rounded-sm p-1 transition-opacity group-[:not(:hover):not(:focus-within)]:pointer-events-none group-[:not(:hover):not(:focus-within)]:opacity-0"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" aria-hidden="true" class="icon"><use href="/cdn/assets/sprites-core-07247886.svg#7fccfb" fill="currentColor"></use></svg></button></span></div></div></div></div>
<p dir="auto" data-start="1181" data-end="1252">That's cleaner and completely consistent with your current application.</p>
<hr data-start="1254" data-end="1257">
<h3 data-section-id="gjlwz4" dir="auto" data-start="1259" data-end="1303">2. Change the sentence above Section 8.4</h3>
<p dir="auto" data-start="1305" data-end="1332">Your report currently says:</p>
<blockquote data-start="1334" data-end="1448">
<p dir="auto" data-start="1336" data-end="1448"><em data-start="1336" data-end="1448">Run python run_pipeline.py to populate the metrics below. The table format is ready to fill in after training.</em></p>
</blockquote>
<p dir="auto" data-start="1450" data-end="1471">That is now outdated.</p>
<p dir="auto" data-start="1473" data-end="1501">Change it to something like:</p>
<blockquote data-start="1503" data-end="1719">
<p dir="auto" data-start="1505" data-end="1719"><strong data-start="1505" data-end="1719">The deployed Random Forest model was evaluated on a stratified 20% test set containing 51,070 observations. The reported metrics correspond to the lightweight deployment model used by the Streamlit application.</strong></p>
</blockquote>
<p dir="auto" data-start="1721" data-end="1828">This is important because you are now using the <strong data-start="1769" data-end="1797">30-tree deployment model</strong>, not the original large model.</p>
<hr data-start="1830" data-end="1833">
<h3 data-section-id="1a5v8nc" dir="auto" data-start="1835" data-end="1880">3. Add the deployment-model configuration</h3>
<p dir="auto" data-start="1882" data-end="1936">Since your current <code data-start="1901" data-end="1926">deployment_model.joblib</code> contains:</p>
<ul data-start="1938" data-end="2069">
<li data-section-id="dywkbu" data-start="1938" data-end="1953">
<p dir="auto" data-start="1940" data-end="1953">Random Forest</p>
</li>
<li data-section-id="1v6dz9a" data-start="1954" data-end="1968">
<p dir="auto" data-start="1956" data-end="1968"><strong data-start="1956" data-end="1968">30 trees</strong></p>
</li>
<li data-section-id="1db29bk" data-start="1969" data-end="1987">
<p dir="auto" data-start="1971" data-end="1987"><code data-start="1971" data-end="1987">max_depth = 12</code></p>
</li>
<li data-section-id="1m3ygti" data-start="1988" data-end="2015">
<p dir="auto" data-start="1990" data-end="2015"><code data-start="1990" data-end="2015">class_weight = balanced</code></p>
</li>
<li data-section-id="1dfqg4g" data-start="2016" data-end="2037">
<p dir="auto" data-start="2018" data-end="2037"><code data-start="2018" data-end="2037">random_state = 42</code></p>
</li>
<li data-section-id="138kh7s" data-start="2038" data-end="2069">
<p dir="auto" data-start="2040" data-end="2069">Decision threshold = <strong data-start="2061" data-end="2069">0.40</strong></p>
</li>
</ul>
<p dir="auto" data-start="2071" data-end="2141">I recommend adding a small table in your methodology/training section:</p>
<div dir="auto" class="group TyagGW_tableContainer"><div tabindex="-1" class="TyagGW_tableWrapper flex flex-col-reverse w-fit"><table data-start="2143" data-end="2388" dir="auto" class="w-fit min-w-(--thread-content-width)"><thead data-start="2143" data-end="2162"><tr data-start="2143" data-end="2162"><th data-start="2143" data-end="2153" data-col-size="sm" class="last:pe-10">Setting</th><th data-start="2153" data-end="2162" data-col-size="sm" class="last:pe-10">Value</th></tr></thead><tbody data-start="2173" data-end="2388"><tr data-start="2173" data-end="2202"><td data-start="2173" data-end="2185" data-col-size="sm">Algorithm</td><td data-start="2185" data-end="2202" data-col-size="sm">Random Forest</td></tr><tr data-start="2203" data-end="2227"><td data-start="2203" data-end="2221" data-col-size="sm">Number of trees</td><td data-start="2221" data-end="2227" data-col-size="sm">30</td></tr><tr data-start="2228" data-end="2250"><td data-start="2228" data-end="2244" data-col-size="sm">Maximum depth</td><td data-start="2244" data-end="2250" data-col-size="sm">12</td></tr><tr data-start="2251" data-end="2281"><td data-start="2251" data-end="2269" data-col-size="sm">Class weighting</td><td data-start="2269" data-end="2281" data-col-size="sm">Balanced</td></tr><tr data-start="2282" data-end="2302"><td data-start="2282" data-end="2296" data-col-size="sm">Random seed</td><td data-start="2296" data-end="2302" data-col-size="sm">42</td></tr><tr data-start="2303" data-end="2332"><td data-start="2303" data-end="2324" data-col-size="sm">Decision threshold</td><td data-start="2324" data-end="2332" data-col-size="sm">0.40</td></tr><tr data-start="2333" data-end="2365"><td data-start="2333" data-end="2352" data-col-size="sm">Train/Test split</td><td data-start="2352" data-end="2365" data-col-size="sm">80% / 20%</td></tr><tr data-start="2366" data-end="2388"><td data-start="2366" data-end="2378" data-col-size="sm">Test rows</td><td data-start="2378" data-end="2388" data-col-size="sm">51,070</td></tr></tbody></table><div class="relative h-0 self-end select-none"><div class="absolute end-0 flex items-end" style="height: 32.7969px;"><span class="" data-state="closed"><button aria-label="Copy table" class="hover:bg-token-bg-tertiary text-token-text-secondary relative z-10 my-1 rounded-sm p-1 transition-opacity group-[:not(:hover):not(:focus-within)]:pointer-events-none group-[:not(:hover):not(:focus-within)]:opacity-0"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" aria-hidden="true" class="icon"><use href="/cdn/assets/sprites-core-07247886.svg#7fccfb" fill="currentColor"></use></svg></button></span></div></div></div></div>
<p dir="auto" data-start="2390" data-end="2451">This will make your report match the model actually deployed.</p>
<hr data-start="2453" data-end="2456">
<h3 data-section-id="7na72u" dir="auto" data-start="2458" data-end="2512">4. Be careful about the "200-tree model" statement</h3>
<p dir="auto" data-start="2514" data-end="2539">Your code previously had:</p>
<blockquote data-start="2541" data-end="2592">
<p dir="auto" data-start="2543" data-end="2592">"full 200-tree model used in the academic report"</p>
</blockquote>
<p dir="auto" data-start="2594" data-end="2654">But the Streamlit deployment now uses the <strong data-start="2636" data-end="2653">30-tree model</strong>.</p>
<p dir="auto" data-start="2656" data-end="2712">Therefore, if your report currently says something like:</p>
<blockquote data-start="2714" data-end="2760">
<p dir="auto" data-start="2716" data-end="2760">Random Forest was trained using 200 trees...</p>
</blockquote>
<p dir="auto" data-start="2762" data-end="2780">you should either:</p>
<ul data-start="2782" data-end="3030">
<li data-section-id="1bof5bn" data-start="2782" data-end="2937">
<p dir="auto" data-start="2784" data-end="2937">keep that statement <strong data-start="2804" data-end="2885">only if you are specifically describing your original/full experimental model</strong>, and clearly distinguish it from deployment, <strong data-start="2931" data-end="2937">or</strong></p>
</li>
<li data-section-id="1g0124j" data-start="2938" data-end="3030">
<p dir="auto" data-start="2940" data-end="3030">change it to <strong data-start="2953" data-end="2965">30 trees</strong> if the report is intended to describe the final deployed system.</p>
</li>
</ul>
<p dir="auto" data-start="3032" data-end="3131">For a final project report focused on the application you are demonstrating, I would clearly state:</p>
<blockquote data-start="3133" data-end="3329">
<p dir="auto" data-start="3135" data-end="3329"><strong data-start="3135" data-end="3329">A lightweight 30-tree Random Forest model was used for deployment to reduce model size and improve application portability while retaining the complete preprocessing and prediction pipeline.</strong></p>
</blockquote>
<hr data-start="3331" data-end="3334">
<h3 data-section-id="1c86ot5" dir="auto" data-start="3336" data-end="3377">5. Add your Streamlit deployment link</h3>
<p dir="auto" data-start="3379" data-end="3478">Since your application is working, add this under a section such as <strong data-start="3447" data-end="3477">Project Links / Deployment</strong>:</p>
<p dir="auto" data-start="3480" data-end="3611"><strong data-start="3480" data-end="3511">Live Streamlit Application:</strong><br data-start="3511" data-end="3514">
<code data-start="3514" data-end="3611">https://loan-default-risk-analysis-and-prediction-ayrecyonj3zrdgrij3w4.streamlit.app/prediction</code></p>
<p dir="auto" data-start="3613" data-end="3717"><strong data-start="3613" data-end="3635">GitHub Repository:</strong><br data-start="3635" data-end="3638">
<code data-start="3638" data-end="3717">https://github.com/AkulaSrinithya24/Loan-Default-Risk-Analysis-and-Prediction</code></p>
<p dir="auto" data-start="3719" data-end="3840">Also, because your report is a Word document, make the text <strong data-start="3779" data-end="3803">clickable hyperlinks</strong> rather than leaving only plain text.</p>
<hr data-start="3842" data-end="3845">
<h3 data-section-id="10ivbes" dir="auto" data-start="3847" data-end="3895">6. Add screenshots of the actual application</h3>
<p dir="auto" data-start="3897" data-end="3952">I recommend adding <strong data-start="3916" data-end="3935">2–3 screenshots</strong>, not every page.</p>
<p dir="auto" data-start="3954" data-end="3967">Good choices:</p>
<ol data-start="3969" data-end="4203">
<li data-section-id="1ptd0nc" data-start="3969" data-end="4052">
<p dir="auto" data-start="3972" data-end="4052"><strong data-start="3972" data-end="3991">Prediction page</strong> showing the prediction result and default probability gauge.</p>
</li>
<li data-section-id="o5hxir" data-start="4053" data-end="4131">
<p dir="auto" data-start="4056" data-end="4131"><strong data-start="4056" data-end="4082">Model Performance page</strong> showing ROC-AUC, Avg Precision, F1 and Accuracy.</p>
</li>
<li data-section-id="buwsa6" data-start="4132" data-end="4203">
<p dir="auto" data-start="4135" data-end="4203"><strong data-start="4135" data-end="4171">Overview/Risk Analysis dashboard</strong> showing your business insights.</p>
</li>
</ol>
<p dir="auto" data-start="4205" data-end="4278">The prediction screenshot you showed is suitable because it demonstrates:</p>
<blockquote data-start="4280" data-end="4365">
<p dir="auto" data-start="4282" data-end="4365">Default Probability: <strong data-start="4303" data-end="4311">8.5%</strong><br data-start="4311" data-end="4314">
Prediction: <strong data-start="4328" data-end="4342">NO DEFAULT</strong><br data-start="4342" data-end="4345">
Risk Tier: <strong data-start="4358" data-end="4365">Low</strong></p>
</blockquote>
<p dir="auto" data-start="4367" data-end="4483">Just make sure you describe it as an <strong data-start="4404" data-end="4426">example prediction</strong>, not as evidence that the model is universally accurate.</p>
<hr data-start="4485" data-end="4488">
<h3 data-section-id="tpi9q5" dir="auto" data-start="4490" data-end="4567">7. Your current report's Section 9 is okay, but don't overstate the model</h3>
<p dir="auto" data-start="4569" data-end="4586">Your report says:</p>
<blockquote data-start="4588" data-end="4670">
<p dir="auto" data-start="4590" data-end="4670"><strong data-start="4590" data-end="4615">[High] Portfolio Risk</strong><br data-start="4615" data-end="4618">
Finding: Overall portfolio default rate is 11.61%.</p>
</blockquote>
<p dir="auto" data-start="4672" data-end="4738">If <strong data-start="4675" data-end="4724">11.61% is calculated from your actual dataset</strong>, that's fine.</p>
<p dir="auto" data-start="4740" data-end="4771">But keep the distinction clear:</p>
<ul data-start="4773" data-end="4929">
<li data-section-id="mxobb6" data-start="4773" data-end="4824">
<p dir="auto" data-start="4775" data-end="4824"><strong data-start="4775" data-end="4785">11.61%</strong> = observed default rate in the dataset</p>
</li>
<li data-section-id="1u6wns7" data-start="4825" data-end="4870">
<p dir="auto" data-start="4827" data-end="4870"><strong data-start="4827" data-end="4837">65.37%</strong> = model accuracy on the test set</p>
</li>
<li data-section-id="4r42pl" data-start="4871" data-end="4893">
<p dir="auto" data-start="4873" data-end="4893"><strong data-start="4873" data-end="4883">74.44%</strong> = ROC-AUC</p>
</li>
<li data-section-id="1dwp5ti" data-start="4894" data-end="4929">
<p dir="auto" data-start="4896" data-end="4929"><strong data-start="4896" data-end="4906">32.42%</strong> = F1 at threshold 0.40</p>
</li>
</ul>
<p dir="auto" data-start="4931" data-end="5004">These are different things and shouldn't be presented as interchangeable.</p>
<hr data-start="5006" data-end="5009">
<h3 data-section-id="a1i7go" dir="auto" data-start="5011" data-end="5077"><span role="text">8. Your <code data-start="5023" data-end="5044">use_container_width</code> warnings don't affect the report</span></h3>
<p dir="auto" data-start="5079" data-end="5100">The terminal warning:</p>
<blockquote data-start="5102" data-end="5151">
<p dir="auto" data-start="5104" data-end="5151"><code data-start="5104" data-end="5151">Please replace use_container_width with width</code></p>
</blockquote>
<p dir="auto" data-start="5153" data-end="5211">is a <strong data-start="5158" data-end="5191">Streamlit deprecation warning</strong>, not a model error.</p>
<p dir="auto" data-start="5213" data-end="5282">Your application is running, so this doesn't invalidate your project.</p>
<p dir="auto" data-start="5284" data-end="5311">You can optionally replace:</p>
<pre class="overflow-visible! px-0!" data-start="5313" data-end="5351"><div class="relative w-full mt-4 mb-1"><div class=""><div class="contents"><div class="border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl"><div class="relative h-full w-full border-radius-3xl bg-(--code-block-surface) corner-superellipse/1.1 overflow-clip rounded-3xl [--code-block-surface:var(--bg-elevated-secondary)] dark:[--code-block-surface:var(--composer-surface-primary)] lxnfua_clipPathFallback"><div class="select-none sticky z-2 top-(--sticky-padding-top)"><div class="flex w-full items-center justify-between py-1.5 ps-4 pe-1.5 font-sans md:ps-5 bg-(--code-block-surface)"><div class="flex max-w-[75%] min-w-0 cursor-default items-center text-sm font-medium justify-self-start text-token-text-primary"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" aria-hidden="true" class="icon-sm me-2.5 shrink-0"><use href="/cdn/assets/sprites-core-07247886.svg#72c6a7" fill="currentColor"></use></svg>Python</div><div class="flex flex-row items-center gap-0.5 justify-self-end"><button type="button" class="flex gap-1 items-center select-none py-2 text-sm font-medium hover:bg-black/5 dark:hover:bg-white/10 size-9 rounded-full px-2" aria-label="Copy" data-state="closed"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" aria-hidden="true" class="icon-md"><use href="/cdn/assets/sprites-core-07247886.svg#7fccfb" fill="currentColor"></use></svg></button><button class="btn relative group-focus-within/dialog:focus-visible:[outline-width:1.5px] group-focus-within/dialog:focus-visible:[outline-offset:2.5px] group-focus-within/dialog:focus-visible:[outline-style:solid] group-focus-within/dialog:focus-visible:[outline-color:var(--text-primary)] btn-ghost border-token-border-default ms-2 border font-sans" aria-label="Run code" type="button"><div class="flex w-full items-center justify-center gap-1.5"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="2